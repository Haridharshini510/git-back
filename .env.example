# AWS Configuration (optional — only needed for cloud sync/dashboard)
# GITBACK_AWS_REGION=us-east-1
# GITBACK_TABLE=claude-code-gitback-dev
# GITBACK_USER_ID=your-user-id

# LLM Configuration (optional — GitBack works without it using structured markdown)
# Supports any OpenAI-compatible API: Ollama, OpenRouter, OpenAI, Google AI Studio, etc.
#
# Ollama (local, free — recommended for getting started):
#   GITBACK_LLM_BASE_URL=http://localhost:11434/v1
#   GITBACK_LLM_MODEL=llama3.1:8b
#
# OpenRouter (many models, some free):
#   GITBACK_LLM_BASE_URL=https://openrouter.ai/api/v1
#   GITBACK_LLM_API_KEY=sk-or-...
#   GITBACK_LLM_MODEL=anthropic/claude-sonnet-4-5
#
# OpenAI:
#   GITBACK_LLM_BASE_URL=https://api.openai.com/v1
#   GITBACK_LLM_API_KEY=sk-...
#   GITBACK_LLM_MODEL=gpt-4o
#
# Google AI Studio (free tier):
#   GITBACK_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   GITBACK_LLM_API_KEY=...
#   GITBACK_LLM_MODEL=gemini-2.0-flash

# API server (for the web dashboard)
PORT=3001

# Frontend
VITE_API_URL=http://localhost:3001
